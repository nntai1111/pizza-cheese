# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# Docker Hub username (must match GitHub secret DOCKERHUB_USERNAME) — required by docker-compose
DOCKERHUB_USERNAME=your-dockerhub-username

# Cùng token với GitHub secret DOCKERHUB_TOKEN — để Watchtower pull được image (đặc biệt nếu repo private)
DOCKERHUB_TOKEN=dckr_pat_xxxxxxxx

# Image tag Watchtower theo dõi — đang push develop thì để develop
IMAGE_TAG=develop

# Spring profile: dev (local IDE) | prod (docker / pizza-store.vn)
SPRING_PROFILES_ACTIVE=dev

# --- Database cho docker-compose (chọn A hoặc B trong docker-compose.yml) ---
# Bật Lựa chọn B (Supabase) trong compose → điền 3 dòng dưới:
DATABASE_URL=jdbc:postgresql://your-host:5432/postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=your-db-password
# Bật Lựa chọn A (Postgres Docker) trong compose → 3 dòng trên không dùng;
#   URL trong container là jdbc:postgresql://db:5432/pizza_cheese
#
# IDE local + Postgres Docker (port host 5433): sửa block B trong application.properties

# JWT — generate with: openssl rand -base64 32
JWT_BASE64_SECRET=your-base64-jwt-secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# VNPay Sandbox (dev) / Production (prod)
VNPAY_TMN_CODE=your-tmn-code
VNPAY_HASH_SECRET=your-hash-secret

# Redis cache (optional in dev — defaults to in-memory cache when false)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_MENU_TTL_SECONDS=600

# --- Dev overrides (optional) ---
# APP_FRONTEND_URL=http://localhost:4201
# APP_CORS_ALLOWED_ORIGINS=http://localhost:4201
# VNPAY_RETURN_URL=http://localhost:8080/api/v1/payments/vnpay/return
# VNPAY_IPN_URL=http://localhost:8080/api/v1/payments/vnpay/ipn

# Gmail SMTP (App Password — bật 2FA rồi tạo tại myaccount.google.com/apppasswords)
MAIL_USERNAME=your-sender@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM=your-sender@gmail.com

# --- Prod overrides (set SPRING_PROFILES_ACTIVE=prod on server) ---
# APP_FRONTEND_URL=https://pizza-store.vn
# APP_CORS_ALLOWED_ORIGINS=https://pizza-store.vn,https://www.pizza-store.vn
# VNPAY_RETURN_URL=https://api.pizza-store.vn/api/v1/payments/vnpay/return
# VNPAY_IPN_URL=https://api.pizza-store.vn/api/v1/payments/vnpay/ipn
